// build.flist : include dirs + sources for the AXI->APB UVM testbench
// ORDER MATTERS: interfaces -> RTL -> UVM package -> top

+incdir+tb
+incdir+uvm
+incdir+sequences
+incdir+tests

// ---- interfaces
tb/axi_bus.sv
tb/apb_bus.sv

// ---- RTL
rtl/fifo.sv
rtl/axi_single_slice.sv
rtl/axi_aw_buffer.sv
rtl/axi_ar_buffer.sv
rtl/axi_w_buffer.sv
rtl/axi_r_buffer.sv
rtl/axi_b_buffer.sv
rtl/axi2apb.sv
rtl/axi2apb_64_32.sv
rtl/axi2apb_wrap.sv

// ---- UVM package (includes uvm/, sequences/, tests/ files)
uvm/axi_apb_pkg.sv

// ---- top
tb/tb_top.sv
